# Keep Unix line endings for files that run inside Linux containers / CI, even when committed from Windows.
mvnw            text eol=lf
*.sh            text eol=lf
Dockerfile      text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
# Windows scripts keep CRLF.
*.bat           text eol=crlf
*.ps1           text eol=crlf
*.cmd           text eol=crlf
