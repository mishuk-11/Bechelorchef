# ---------------------------------------------------------------------------
# Bachelor Chef ERP — example configuration. Copy to .env and set real values.
# Never commit .env. Placeholders below are NOT secure for production.
# ---------------------------------------------------------------------------

# Database (docker-compose.yml reads these; install.bat creates a private database on LOCAL_PG_PORT instead)
LOCAL_PG_PORT=5433
POSTGRES_DB=bachelor_chef
POSTGRES_USER=bachelor_chef_app
POSTGRES_PASSWORD=change_me_locally
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bachelor_chef
SPRING_DATASOURCE_USERNAME=bachelor_chef_app
SPRING_DATASOURCE_PASSWORD=change_me_locally

# Backend
SPRING_PROFILES_ACTIVE=dev                 # dev (loads sample recipes) | prod
SERVER_PORT=8080
APP_FRONTEND_ORIGINS=http://localhost:3000 # comma-separated exact origins; no wildcards in prod
APP_JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
APP_ACCESS_TOKEN_TTL_MINUTES=15
APP_REFRESH_TOKEN_TTL_DAYS=14
APP_COOKIE_SECURE=false                    # true in production (HTTPS)
APP_COOKIE_SAME_SITE=Lax                   # Lax with the same-origin proxy; None only for cross-site setups
APP_IMPORT_MAX_BYTES=5242880
APP_ALLOWED_IMAGE_HOSTS=res.cloudinary.com,images.unsplash.com,images.pexels.com,upload.wikimedia.org
APP_RATE_LIMIT_ENABLED=true

# First administrator (created once if the email does not exist; never reset afterwards)
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace_me_with_12+_chars
BOOTSTRAP_ADMIN_NAME=Bachelor Chef Admin

# Media provider (optional locally; without it, users paste https image links)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bachelor-chef

# Frontend (see frontend/.env.example)
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://localhost:8080

# Selenium UI tests (e2e/)
E2E_BASE_URL=http://localhost:3000
E2E_ADMIN_EMAIL=admin@example.test
E2E_ADMIN_PASSWORD=replace_me_with_12+_chars
